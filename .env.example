# Story Weaver / Clues - Environment Variables Example

# Google Gemini API key for AI Bot narrations
GEMINI_API_KEY=your_gemini_api_key_here

# PartyKit Server host (default local: localhost:1999)
PARTYKIT_HOST=localhost:1999

# Secret Bearer Token for protected /metrics endpoint
METRICS_SECRET_TOKEN=your_metrics_secret_token_here
